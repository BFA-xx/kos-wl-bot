// KOS WL Bot — database schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RaffleStatus {
  DRAFT
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

/// How the eligible roles are combined.
/// ANY  = user needs at least one of the selected roles.
/// ALL  = user must hold every selected role.
enum RoleMatchMode {
  ANY
  ALL
}

enum WalletChain {
  ETHEREUM
  BASE
  ROBINHOOD
  SOLANA
  BITCOIN
}

enum TeamWalletStatus {
  AVAILABLE
  RESERVED
  DISABLED
}

enum TeamWalletUsageStatus {
  RESERVED
  RELEASED
}

enum TeamWalletSelectionMode {
  ROUND_ROBIN
  RANDOM
  PRIORITY
}

enum LogCategory {
  RAFFLE
  ENTRY
  WINNER
  REROLL
  WALLET
  BLACKLIST
  VERIFICATION
  ADMIN
  SYSTEM
}

enum VerificationAttemptStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum VerificationLogStatus {
  SUCCESS
  FAILURE
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

/// A Discord server (guild) using the bot, plus its configuration.
model Guild {
  id                       String   @id // Discord guild snowflake
  name                     String?
  iconUrl                  String?
  /// Roles allowed to run /raffle and /blacklist admin commands.
  managerRoleIds           String[] @default([])
  /// Default channel where new raffle posts should be published.
  defaultRaffleChannelId   String?
  /// Default channel where new Raid posts and proof threads should be published.
  defaultRaidChannelId     String?
  /// Default channel for winner announcements (overridable per raffle).
  defaultAnnounceChannelId String?
  /// Default channel for proof delivery (overridable per raffle).
  defaultProofChannelId    String?
  /// Default channel where points/rewards activity and leaderboards are hosted.
  defaultPointsChannelId   String?
  logChannelId             String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  raffles    Raffle[]
  blacklists Blacklist[]
  logs       Log[]
  raids      Raid[]

  verificationSettings    VerificationSettings?
  verificationCodes       VerificationCode[]
  verificationAttempts    VerificationAttempt[]
  verificationRedemptions VerificationRedemption[]
  verificationLogs        VerificationLog[]
  memberVerifications     MemberVerification[]
  discordMembers          DiscordGuildMember[]
  telegramCommunities     TelegramCommunity[]

  @@map("guilds")
}

/// A Discord user seen by the bot (global identity). Also the dashboard's
/// authenticated identity once they sign in with Discord (Phase 2).
model User {
  id         String   @id // Discord user snowflake
  username   String
  globalName String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // --- Dashboard auth (Phase 2, all optional so the bot is unaffected) ---
  email          String?
  /// OAuth2 tokens, encrypted at rest (AES-256-GCM, WALLET_ENCRYPTION_KEY).
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  /// KOS staff flag, seeded from SUPER_ADMIN_DISCORD_IDS on login.
  isSuperAdmin   Boolean   @default(false)
  lastLoginAt    DateTime?

  participants   Participant[]
  winners        Winner[]
  wallets        Wallet[]
  walletProfiles WalletProfile[]
  blacklists     Blacklist[]

  // Phase 2 organization relations.
  ownedOrgs   Organization[]       @relation("OrgOwner")
  memberships OrganizationMember[]

  // Phase 3: linked external accounts (X, etc).
  connectedAccounts    ConnectedAccount[]
  TaskCompletion       TaskCompletion[]
  pointsLedger         PointsLedger[]
  rewardRedemptions    RewardRedemption[]
  notifications        Notification[]
  collaborationWallets CollaborationWallet[]
  campaignEnrollments  CampaignEnrollment[]
  raidParticipants     RaidParticipant[]
  raidSubmissions      RaidSubmission[]
  teamWallets          TeamWallet[]           @relation("TeamWalletOwner")
  teamWalletPoolSeats  TeamWalletPoolMember[] @relation("TeamWalletPoolMemberUser")
  teamWalletFills      RaffleTeamWalletFill[] @relation("TeamWalletFillCreator")
  releasedTeamWallets  TeamWalletUsage[]      @relation("TeamWalletUsageReleaser")
  discordGuilds        DiscordGuildMember[]
  kosIdentity          KosIdentity?

  /// Last time the user opened their notification feed (announcement unread
  /// counts are computed against this instead of materializing rows).
  notificationsSeenAt DateTime?

  @@map("users")
}

/// Durable snapshot of a non-bot Discord member in a guild. Discord remains
/// the source of truth for membership; this table gives external KOS surfaces
/// a stable, guild-scoped view without requiring direct Gateway access.
model DiscordGuildMember {
  guildId     String
  userId      String
  username    String
  globalName  String?
  nickname    String?
  displayName String
  avatarUrl   String?
  joinedAt    DateTime?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  leftAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, isActive, username])
  @@index([userId])
  @@map("discord_guild_members")
}

/// A user's self-registered wallet for a chain, reusable across raffles.
/// One address per (user, chain); updatable any time by the user.
model WalletProfile {
  id        Int         @id @default(autoincrement())
  userId    String
  chain     WalletChain
  address   String // encrypted at rest when WALLET_ENCRYPTION_KEY is set
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain])
  @@index([userId])
  @@map("wallet_profiles")
}

/// A whitelist raffle. `id` doubles as the human-facing Raffle ID (#2345).
model Raffle {
  id            Int           @id @default(autoincrement())
  guildId       String
  projectName   String
  title         String
  description   String?
  spots         Int
  roleMatchMode RoleMatchMode @default(ANY)
  status        RaffleStatus  @default(UPCOMING)

  startAt DateTime
  endAt   DateTime

  /// Channel where the live raffle embed is posted.
  channelId         String?
  /// Message id of the live raffle embed (for live updates).
  messageId         String?
  /// Channel where the winner announcement is posted.
  announceChannelId String?
  /// Channel where the proof package is delivered.
  proofChannelId    String?

  bannerUrl   String?
  externalUrl String?

  /// Anti-alt / entry requirements (see EntryRequirements type in the bot).
  requirements Json?

  /// Whether winners should be DMed a wallet collection form.
  collectWallets Boolean       @default(true)
  walletChains   WalletChain[] @default([ETHEREUM])

  /// When true, a user must have a registered wallet (for one of walletChains)
  /// before they can enter.
  requireWallet Boolean @default(false)

  /// When true, participant weights are snapshotted from org role multipliers
  /// at entry and the final draw uses the weighted verifiable sampler.
  useRoleWeights Boolean @default(false)

  entryCount Int @default(0)

  /// When true, the live embed hides the entry count / entrant list.
  hideEntries Boolean @default(false)

  /// Who to ping when the raffle goes live: "none" | "here" | "everyone".
  startPing   String  @default("everyone")
  /// Guards against double-pinging.
  startPinged Boolean @default(false)

  /// Hex commitment of the seed used for the verifiable draw.
  drawSeed     String?
  drawSeedHash String?

  /// Dashboard-requested reroll, picked up + cleared by the bot scheduler.
  /// Shape: { mode, count?, userIds?, actorId }.
  rerollRequest     Json?
  rerollRequestedAt DateTime?

  /// Set by the dashboard after an edit; the bot re-renders the live post.
  editRequestedAt DateTime?

  createdById     String
  createdByName   String?
  createdByAvatar String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  endedAt         DateTime?
  drawnAt         DateTime?

  guild                 Guild                       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  eligibleRoles         RaffleRole[]
  participants          Participant[]
  winners               Winner[]
  proof                 Proof?
  bannerAsset           RaffleBannerAsset?
  logs                  Log[]
  RaffleTask            RaffleTask[]
  campaignRaffles       CampaignRaffle[]
  collaborationLink     CollaborationRaffle?
  teamWalletFills       RaffleTeamWalletFill[]
  teamWalletUsages      TeamWalletUsage[]
  telegramPublications  TelegramRafflePublication[]
  eligibilityRules      RaffleEligibilityRule[]
  integrationDeliveries IntegrationDelivery[]

  @@index([guildId, status])
  @@index([status, endAt])
  @@index([status, startAt])
  @@map("raffles")
}

/// Durable copy of a Discord-uploaded raffle banner. Discord interaction
/// attachment URLs expire, so the bot stores the bytes before publication and
/// both runtimes serve the shared copy through the public raffle origin.
model RaffleBannerAsset {
  raffleId    Int      @id
  sourceUrl   String?
  contentType String
  byteLength  Int
  data        Bytes
  storedAt    DateTime @default(now()) @updatedAt

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@map("raffle_banner_assets")
}

/// A role that is eligible to enter a given raffle.
model RaffleRole {
  id       Int    @id @default(autoincrement())
  raffleId Int
  roleId   String
  roleName String

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, roleId])
  @@map("raffle_roles")
}

/// Organization-level role multipliers for weighted raffles. A participant's
/// entry weight is the maximum multiplier of their held roles at entry time.
model RoleWeight {
  id             String   @id @default(cuid())
  organizationId String
  guildId        String
  roleId         String
  roleName       String
  multiplier     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, roleId])
  @@index([organizationId, guildId])
  @@map("role_weights")
}

/// A single entry into a raffle.
model Participant {
  id        Int      @id @default(autoincrement())
  raffleId  Int
  userId    String
  username  String // snapshot at entry time
  enteredAt DateTime @default(now())

  // Anti-alt snapshot data captured at entry time.
  accountCreatedAt DateTime?
  joinedGuildAt    DateTime?
  flagged          Boolean   @default(false)
  flagReason       String?
  /// Snapshot used by weighted draws. Defaults to 1 for uniform odds.
  weight           Int       @default(1)

  raffle Raffle  @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  winner Winner?

  @@unique([raffleId, userId])
  @@index([raffleId])
  @@map("participants")
}

/// A selected winner of a raffle.
model Winner {
  id            Int      @id @default(autoincrement())
  raffleId      Int
  userId        String
  username      String
  position      Int
  selectedAt    DateTime @default(now())
  /// True if this winner was added through a reroll.
  fromReroll    Boolean  @default(false)
  /// True if this winner was replaced by a reroll (kept for audit).
  replaced      Boolean  @default(false)
  participantId Int?     @unique

  raffle              Raffle               @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  participant         Participant?         @relation(fields: [participantId], references: [id], onDelete: SetNull)
  wallet              Wallet?
  collaborationWallet CollaborationWallet?

  @@index([raffleId])
  @@index([raffleId, userId])
  @@map("winners")
}

/// A wallet address submitted by a winner.
model Wallet {
  id          Int         @id @default(autoincrement())
  userId      String
  winnerId    Int?        @unique
  chain       WalletChain
  address     String
  submittedAt DateTime    @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  winner Winner? @relation(fields: [winnerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

/// Per-guild blacklist; blacklisted users cannot enter raffles.
model Blacklist {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  reason    String?
  addedById String
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
  @@map("blacklists")
}

/// Generated proof package for a completed raffle.
model Proof {
  id                      Int       @id @default(autoincrement())
  raffleId                Int       @unique
  messageLink             String?
  pdfPath                 String?
  csvPath                 String?
  cardPath                String?
  pdfData                 Bytes?
  csvData                 Bytes?
  cardData                Bytes?
  artifactsStoredAt       DateTime?
  artifactSyncAttemptedAt DateTime?
  generatedAt             DateTime  @default(now())

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@map("proofs")
}

/// Audit log entry.
model Log {
  id        Int         @id @default(autoincrement())
  guildId   String
  raffleId  Int?
  actorId   String? // who performed the action (null = system)
  category  LogCategory
  action    String // e.g. RAFFLE_CREATE, ENTRY_ADD
  message   String
  metadata  Json?
  createdAt DateTime    @default(now())

  guild  Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  raffle Raffle? @relation(fields: [raffleId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt])
  @@index([raffleId])
  @@map("logs")
}

/// Per-server KOS onboarding configuration. Discord-side channel permissions,
/// messages, role assignment, and member events remain owned by the bot.
model VerificationSettings {
  guildId String @id

  enabled Boolean @default(false)

  verificationChannelId String?
  rulesChannelId        String?
  logChannelId          String?
  unverifiedRoleId      String?
  allowedChannelIds     String[] @default([])
  defaultRoleIds        String[] @default([])

  welcomeTitle       String  @default("Welcome to KOS.")
  welcomeDescription String  @default("Before accessing the server, please verify yourself.\n\nClick the button below to continue.")
  welcomeColor       Int     @default(12632256)
  verifyButtonLabel  String  @default("Verify")
  verifyButtonEmoji  String?

  modalTitle       String @default("Verify Access")
  modalFieldLabel  String @default("Verification Code")
  modalPlaceholder String @default("Enter your access code...")

  requireCode            Boolean @default(true)
  requireRulesAcceptance Boolean @default(false)
  preventCodeReuse       Boolean @default(true)

  successMessage String @default("Verification complete. Welcome to KOS.")
  failureMessage String @default("That verification code is invalid, expired, or unavailable.")

  panelMessageId   String?
  panelPublishedAt DateTime?

  /// Dashboard control plane. The dashboard writes a revisioned request and
  /// the bot clears that exact revision after applying Discord side effects.
  desiredEnabled        Boolean?
  accessSyncRequested   Boolean   @default(false)
  accessCleanupRoleIds  String[]  @default([])
  panelPublishRequested Boolean   @default(false)
  controlRequestId      String?
  controlRequestedAt    DateTime?
  controlRequestedById  String?
  controlProcessedAt    DateTime?
  controlError          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([controlRequestId])
  @@map("verification_settings")
}

/// A guild-scoped access code. Each code can independently grant roles, expire,
/// limit total uses, and opt into one-redemption-per-member protection.
model VerificationCode {
  id      String @id @default(cuid())
  guildId String
  code    String

  description      String?
  roleIds          String[]  @default([])
  maxUses          Int?
  uses             Int       @default(0)
  expiresAt        DateTime?
  active           Boolean   @default(true)
  oneTimePerMember Boolean   @default(true)
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  guild       Guild                    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  attempts    VerificationAttempt[]
  redemptions VerificationRedemption[]
  logs        VerificationLog[]
  members     MemberVerification[]

  @@unique([guildId, code])
  @@index([guildId, active])
  @@index([guildId, createdAt])
  @@map("verification_codes")
}

/// Short-lived, durable verification flow state. A code is validated when the
/// modal is submitted, but only claimed when the member completes the flow.
model VerificationAttempt {
  id      String  @id @default(cuid())
  guildId String
  userId  String
  codeId  String?

  status          VerificationAttemptStatus @default(PENDING)
  rulesAcceptedAt DateTime?
  failureReason   String?
  expiresAt       DateTime
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  guild      Guild                   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  code       VerificationCode?       @relation(fields: [codeId], references: [id], onDelete: SetNull)
  redemption VerificationRedemption?

  @@index([guildId, userId, createdAt])
  @@index([status, expiresAt])
  @@map("verification_attempts")
}

/// Append-only record of a successfully claimed code. The code text and role
/// snapshot remain available to admins even if the source code is later deleted.
model VerificationRedemption {
  id         String   @id @default(cuid())
  guildId    String
  codeId     String?
  attemptId  String   @unique
  userId     String
  code       String
  roleIds    String[] @default([])
  redeemedAt DateTime @default(now())

  guild   Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  source  VerificationCode?   @relation(fields: [codeId], references: [id], onDelete: SetNull)
  attempt VerificationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([codeId, redeemedAt])
  @@map("verification_redemptions")
}

/// Append-only verification audit stream, distinct from the general raffle log
/// so onboarding success/failure reporting can be queried independently.
model VerificationLog {
  id      String  @id @default(cuid())
  guildId String
  userId  String
  codeId  String?
  code    String?

  status          VerificationLogStatus
  reason          String?
  roleIds         String[]              @default([])
  rulesAcceptedAt DateTime?
  createdAt       DateTime              @default(now())

  guild  Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  source VerificationCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt])
  @@index([guildId, userId, createdAt])
  @@map("verification_logs")
}

/// Current per-member verification state for fast status checks and a durable
/// rules-acceptance timestamp. VerificationLog remains the immutable history.
model MemberVerification {
  id      String  @id @default(cuid())
  guildId String
  userId  String
  codeId  String?

  roleIds         String[]  @default([])
  rulesAcceptedAt DateTime?
  verifiedAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  guild  Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  source VerificationCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)

  @@unique([guildId, userId])
  @@index([guildId, verifiedAt])
  @@map("member_verifications")
}

// ---------------------------------------------------------------------------
// Phase 2 — Multi-tenant platform (Organizations)
//
// All models below are additive. The bot never reads or writes them, so the
// existing single-tenant bot keeps working unchanged. Isolation is enforced in
// the dashboard by resolving Guild -> GuildConnection -> Organization.
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  PRO
  SCALE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum OrgMemberStatus {
  INVITED
  ACTIVE
}

enum AnnouncementLevel {
  INFO
  WARNING
  CRITICAL
}

// ---------------------------------------------------------------------------
// Phase 4 — Collab Hub
// ---------------------------------------------------------------------------

enum CollaborationStatus {
  LEAD
  REACHED_OUT
  NEGOTIATING
  CONFIRMED
  SCHEDULED
  HOSTING
  COLLECTING_WALLETS
  READY_FOR_SUBMISSION
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum CollaborationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CollaborationSubmissionStatus {
  NOT_STARTED
  COLLECTING
  READY
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum CollaborationWalletStatus {
  WAITING
  COLLECTED
  SUBMITTED
  REJECTED
}

enum CollaborationReminderType {
  HOSTING
  WALLET_SUBMISSION
  COLLABORATION_DEADLINE
  FOLLOW_UP
  INACTIVE
  CUSTOM
}

/// A community/tenant. Owns all of its resources (via connected guilds).
model Organization {
  id          String    @id @default(cuid())
  /// Vanity handle used in the dashboard URL space (/[slug]/...).
  slug        String    @unique
  name        String
  logoUrl     String?
  bannerUrl   String?
  description String?
  /// Optional public X profile handle (stored without @ or URL wrapper).
  xHandle     String?
  ownerId     String
  /// When set, the org is suspended by a KOS super-admin (access blocked).
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner                     User                       @relation("OrgOwner", fields: [ownerId], references: [id])
  members                   OrganizationMember[]
  roles                     OrganizationRole[]
  invites                   OrganizationInvite[]
  guildConnections          GuildConnection[]
  subscription              Subscription?
  auditLogs                 AuditLog[]
  TaskDefinition            TaskDefinition[]
  pointsLedger              PointsLedger[]
  roleWeights               RoleWeight[]
  rewards                   Reward[]
  rewardRedemptions         RewardRedemption[]
  campaigns                 Campaign[]
  raids                     Raid[]
  collaborations            Collaboration[]
  collaborationPartners     CollaborationPartner[]
  collaborationTags         CollaborationTag[]
  collaborationSavedFilters CollaborationSavedFilter[]
  teamWalletPools           TeamWalletPool[]
  telegramCommunities       TelegramCommunity[]

  @@index([ownerId])
  @@map("organizations")
}

/// A user's membership in an organization, with an assigned role.
model OrganizationMember {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         OrgMemberStatus @default(ACTIVE)
  invitedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         OrganizationRole @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

/// An organization-owned wallet pool. The default pool powers the current
/// dashboard; keeping wallets behind a pool makes future team-specific pools
/// additive instead of requiring a data migration.
model TeamWalletPool {
  id                  String                  @id @default(cuid())
  organizationId      String
  name                String                  @default("Team Wallet Pool")
  isDefault           Boolean                 @default(true)
  selectionMode       TeamWalletSelectionMode @default(ROUND_ROBIN)
  lastSelectedOwnerId String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamWalletPoolMember[]
  wallets      TeamWallet[]
  fills        RaffleTeamWalletFill[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
  @@map("team_wallet_pools")
}

/// Priority and future membership metadata for a person inside a pool.
model TeamWalletPoolMember {
  id        String   @id @default(cuid())
  poolId    String
  userId    String
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pool TeamWalletPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user User           @relation("TeamWalletPoolMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@index([poolId, priority])
  @@index([userId])
  @@map("team_wallet_pool_members")
}

/// A validated team wallet. Address bytes use the shared wallet encryption
/// scheme; addressHash is deterministic and globally unique for deduplication.
model TeamWallet {
  id          String           @id @default(cuid())
  poolId      String
  ownerId     String
  /// Backward-compatible primary chain for older runtimes and records.
  chain       WalletChain
  /// Every raffle chain this address may serve. New runtimes prefer this set.
  chains      WalletChain[]    @default([])
  address     String
  addressHash String           @unique
  status      TeamWalletStatus @default(AVAILABLE)
  tags        String[]         @default([])
  timesUsed   Int              @default(0)
  lastUsedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  pool   TeamWalletPool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  owner  User              @relation("TeamWalletOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  usages TeamWalletUsage[]

  @@index([poolId, status])
  @@index([poolId, ownerId, status])
  @@index([ownerId])
  @@map("team_wallets")
}

/// One immutable reservation/release history row for a wallet used by a
/// raffle. Project is snapshotted so history remains legible after renames.
model TeamWalletUsage {
  id           String                @id @default(cuid())
  walletId     String
  raffleId     Int
  fillId       String
  projectName  String
  status       TeamWalletUsageStatus @default(RESERVED)
  reservedAt   DateTime              @default(now())
  releasedAt   DateTime?
  releasedById String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  wallet     TeamWallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  raffle     Raffle               @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  fill       RaffleTeamWalletFill @relation(fields: [fillId], references: [id], onDelete: Cascade)
  releasedBy User?                @relation("TeamWalletUsageReleaser", fields: [releasedById], references: [id], onDelete: SetNull)

  @@unique([walletId, raffleId])
  @@index([raffleId, status])
  @@index([walletId, reservedAt])
  @@map("team_wallet_usages")
}

/// Audit batch for each Fill Team Wallets confirmation.
model RaffleTeamWalletFill {
  id               String                  @id @default(cuid())
  poolId           String
  raffleId         Int
  selectionMode    TeamWalletSelectionMode
  requiredWallets  Int
  communityWallets Int
  selectedWallets  Int
  createdById      String
  createdAt        DateTime                @default(now())

  pool      TeamWalletPool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  raffle    Raffle            @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  createdBy User              @relation("TeamWalletFillCreator", fields: [createdById], references: [id], onDelete: Restrict)
  usages    TeamWalletUsage[]

  @@index([raffleId, createdAt])
  @@index([poolId, createdAt])
  @@map("raffle_team_wallet_fills")
}

/// A role within an organization, carrying a set of permission strings.
model OrganizationRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Canonical permission strings (see @kos/db permissions.ts).
  permissions    String[] @default([])
  /// Built-in roles (Owner/Admin/Moderator/Collab Manager/Viewer).
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  invites      OrganizationInvite[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("organization_roles")
}

/// A pending invite to join an organization (by Discord id or email).
model OrganizationInvite {
  id             String    @id @default(cuid())
  organizationId String
  discordUserId  String?
  email          String?
  roleId         String
  token          String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         OrganizationRole @relation(fields: [roleId], references: [id])

  @@index([organizationId])
  @@index([discordUserId])
  @@map("organization_invites")
}

/// Links a Discord server (guild) to an organization. A guild belongs to at
/// most one org (@unique guildId) — this is the isolation anchor.
model GuildConnection {
  id                String   @id @default(cuid())
  organizationId    String
  guildId           String   @unique
  connectedById     String
  ownershipVerified Boolean  @default(false)
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("guild_connections")
}

/// An organization's subscription (scaffold — every org starts FREE/ACTIVE).
model Subscription {
  id               String             @id @default(cuid())
  organizationId   String             @unique
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Organization-scoped audit trail (distinct from the bot's per-guild Log).
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

/// A project/community this organization has collaborated with. Partner data
/// is durable across individual collaboration records and becomes the
/// organization-private relationship directory.
model CollaborationPartner {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  logoUrl        String?
  bannerUrl      String?
  websiteUrl     String?
  discordUrl     String?
  xUrl           String?
  bio            String?
  xVerified      Boolean  @default(false)
  chain          String?
  category       String?
  privateNotes   String?
  trustRating    Int?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collaborations Collaboration[]
  contacts       CollaborationContact[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, updatedAt])
  @@map("collaboration_partners")
}

/// One organization-owned whitelist collaboration. Operational state lives
/// here while raffle entries, winners, wallets, and proofs remain in their
/// existing source-of-truth tables and are linked through CollaborationRaffle.
model Collaboration {
  id                       String                        @id @default(cuid())
  organizationId           String
  partnerId                String
  projectName              String
  status                   CollaborationStatus           @default(LEAD)
  priority                 CollaborationPriority         @default(MEDIUM)
  submissionStatus         CollaborationSubmissionStatus @default(NOT_STARTED)
  whitelistAllocation      Int                           @default(0)
  fcfsSpots                Int                           @default(0)
  documentUrl              String?
  requirements             String?
  primaryContactName       String?
  discordUsername          String?
  telegram                 String?
  email                    String?
  ownerId                  String?
  assignedToId             String?
  reviewerId               String?
  hostAt                   DateTime?
  hostingDeadline          DateTime?
  walletSubmissionDeadline DateTime?
  collaborationDeadline    DateTime?
  followUpAt               DateTime?
  noResponseDays           Int                           @default(5)
  lastActivityAt           DateTime                      @default(now())
  exportedAt               DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  archivedAt               DateTime?
  createdById              String
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner      CollaborationPartner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  raffles      CollaborationRaffle[]
  wallets      CollaborationWallet[]
  contacts     CollaborationContact[]
  notes        CollaborationNote[]
  comments     CollaborationComment[]
  attachments  CollaborationAttachment[]
  activities   CollaborationActivity[]
  reminders    CollaborationReminder[]
  tags         CollaborationTagAssignment[]

  @@index([organizationId, status])
  @@index([organizationId, hostAt])
  @@index([organizationId, walletSubmissionDeadline])
  @@index([organizationId, updatedAt])
  @@index([partnerId])
  @@map("collaborations")
}

/// Configuration-only link between a collaboration and an existing raffle.
/// A raffle can belong to at most one collaboration, preventing split wallet
/// submission state across two CRM records.
model CollaborationRaffle {
  id              String   @id @default(cuid())
  collaborationId String
  raffleId        Int      @unique
  attachedById    String
  createdAt       DateTime @default(now())

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  raffle        Raffle        @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([collaborationId, raffleId])
  @@index([collaborationId])
  @@map("collaboration_raffles")
}

/// Per-member submission state for an attached raffle winner. Wallet address
/// data is deliberately not copied; exports resolve the existing encrypted
/// Winner.wallet or WalletProfile at read time.
model CollaborationWallet {
  id              String                    @id @default(cuid())
  collaborationId String
  userId          String
  winnerId        Int?                      @unique
  chain           WalletChain?
  status          CollaborationWalletStatus @default(WAITING)
  rejectionReason String?
  submittedAt     DateTime?
  updatedById     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  winner        Winner?       @relation(fields: [winnerId], references: [id], onDelete: SetNull)

  @@unique([collaborationId, userId])
  @@index([collaborationId, status])
  @@index([userId])
  @@map("collaboration_wallets")
}

model CollaborationContact {
  id              String   @id @default(cuid())
  partnerId       String
  collaborationId String?
  name            String
  role            String?
  discord         String?
  telegram        String?
  xUrl            String?
  email           String?
  notes           String?
  conversation    String?
  isPrimary       Boolean  @default(false)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner       CollaborationPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  collaboration Collaboration?       @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([collaborationId])
  @@map("collaboration_contacts")
}

model CollaborationNote {
  id              String   @id @default(cuid())
  collaborationId String
  authorId        String
  body            String
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId, pinned, createdAt])
  @@map("collaboration_notes")
}

model CollaborationComment {
  id               String   @id @default(cuid())
  collaborationId  String
  authorId         String
  body             String
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId, createdAt])
  @@map("collaboration_comments")
}

model CollaborationAttachment {
  id              String   @id @default(cuid())
  collaborationId String
  name            String
  url             String   @unique
  mimeType        String?
  size            Int?
  kind            String?
  uploadedById    String
  createdAt       DateTime @default(now())

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId, createdAt])
  @@map("collaboration_attachments")
}

model CollaborationActivity {
  id              String   @id @default(cuid())
  collaborationId String
  actorId         String?
  action          String
  title           String
  body            String?
  metadata        Json?
  createdAt       DateTime @default(now())

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId, createdAt])
  @@map("collaboration_activities")
}

model CollaborationReminder {
  id              String                    @id @default(cuid())
  collaborationId String
  type            CollaborationReminderType
  title           String
  dueAt           DateTime
  automatic       Boolean                   @default(false)
  completedAt     DateTime?
  notifiedAt      DateTime?
  createdById     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId, dueAt])
  @@index([dueAt, notifiedAt])
  @@map("collaboration_reminders")
}

model CollaborationTag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  color          String   @default("#3B82F6")
  createdAt      DateTime @default(now())

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  CollaborationTagAssignment[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, name])
  @@map("collaboration_tags")
}

model CollaborationTagAssignment {
  collaborationId String
  tagId           String

  collaboration Collaboration    @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  tag           CollaborationTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([collaborationId, tagId])
  @@index([tagId])
  @@map("collaboration_tag_assignments")
}

model CollaborationSavedFilter {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  view           String   @default("TABLE")
  criteria       Json
  createdById    String
  shared         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("collaboration_saved_filters")
}

/// Tiny key-value store for service liveness (e.g. the bot heartbeat the
/// Super Admin health page reads). Written by the bot, read by the dashboard.
model SystemStatus {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt

  @@map("system_status")
}

/// Global feature flags (Super Admin).
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// Phase 3 — Universal account linking (Task Verification Engine foundation)
// ---------------------------------------------------------------------------

enum AccountProvider {
  X
  TELEGRAM
  GITHUB
}

/// An external account linked to a KOS user (X now; Telegram/GitHub reserved).
/// One external account can belong to only ONE KOS user (anti-alt), and a user
/// holds at most one account per provider.
model ConnectedAccount {
  id             String          @id @default(cuid())
  userId         String
  provider       AccountProvider
  /// Provider-side stable id (e.g. X numeric user id).
  externalId     String
  /// Display handle at link time (without the @).
  handle         String?
  /// Provider display name, which may exist even when no public handle does.
  displayName    String?
  /// When KOS last proved control of this provider identity.
  verifiedAt     DateTime?
  /// Last provider interaction observed by KOS.
  lastSeenAt     DateTime?
  /// OAuth tokens, encrypted at rest (AES-256-GCM, WALLET_ENCRYPTION_KEY).
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("connected_accounts")
}

enum KosIdentityStatus {
  ACTIVE
  SUSPENDED
}

enum KosOnboardingStatus {
  STARTED
  PROFILE_COMPLETE
  COMPLETED
}

enum IdentityProvider {
  TELEGRAM
  DISCORD
  X
  WEBSITE
  MINTOOOR
}

/// Provider-neutral KOS identity. `legacyUserId` bridges the existing
/// Discord-backed product account without changing raffle ownership.
model KosIdentity {
  id               String              @id @default(cuid())
  legacyUserId     String?             @unique
  referralCode     String?             @unique
  displayName      String
  status           KosIdentityStatus   @default(ACTIVE)
  onboardingStatus KosOnboardingStatus @default(STARTED)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  legacyUser             User?                      @relation(fields: [legacyUserId], references: [id], onDelete: SetNull)
  accounts               IdentityAccount[]
  pointTransactions      KosPointTransaction[]
  referralsMade          KosReferral[]              @relation("KosReferralReferrer")
  referralReceived       KosReferral?               @relation("KosReferralReferred")
  telegramMemberships    TelegramCommunityMember[]
  notificationPreference KosNotificationPreference?

  @@index([status, createdAt])
  @@map("kos_identities")
}

/// Stable provider identities attached to one KOS identity. Provider user IDs,
/// never usernames, are the uniqueness and trust boundary.
model IdentityAccount {
  id          String           @id @default(cuid())
  identityId  String
  provider    IdentityProvider
  externalId  String
  username    String?
  displayName String?
  firstName   String?
  lastName    String?
  verifiedAt  DateTime?
  lastSeenAt  DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  identity KosIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@unique([identityId, provider])
  @@index([identityId])
  @@map("identity_accounts")
}

enum TelegramCommunityStatus {
  ACTIVE
  DISABLED
}

enum TelegramWinnerVisibility {
  PUBLIC
  ANONYMOUS
  ADMIN_ONLY
}

enum RaffleEligibilityProvider {
  TELEGRAM
  KOS
}

enum RaffleEligibilityType {
  TELEGRAM_CHAT_MEMBER
  TELEGRAM_CHAT_STATUS
  KOS_ACCOUNT_LINKED
  INVITE_ONLY
}

enum RaffleEligibilityCheckAt {
  ENTRY
  DRAW
  BOTH
}

enum TelegramUpdateStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum IntegrationActionType {
  TELEGRAM_LINK
  TELEGRAM_ENTER
}

enum IntegrationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum IntegrationDeliveryEvent {
  RAFFLE_CREATED
  RAFFLE_STARTING
  RAFFLE_ENDING_SOON
  RAFFLE_COMPLETED
  WINNER_SELECTED
  RAFFLE_CANCELLED
}

enum KosPointEvent {
  USER_JOINED
  ONBOARDING_COMPLETED
  RAFFLE_ENTERED
  RAFFLE_WON
  REFERRAL_COMPLETED
  COMMUNITY_EVENT
  ADMIN_REWARD
}

enum KosReferralStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum TelegramCommunityMemberStatus {
  ACTIVE
  LEFT
  BANNED
}

enum KosCommunityApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TelegramConversationKind {
  QUICK_RAFFLE
}

enum KosModerationActionType {
  WARN
  MUTE
  BAN
  UNBAN
}

/// One Telegram group/channel explicitly authorized by a KOS organization.
model TelegramCommunity {
  id                    String                  @id @default(cuid())
  organizationId        String
  backingGuildId        String
  telegramChatId        String                  @unique
  communityName         String
  status                TelegramCommunityStatus @default(ACTIVE)
  featureFlags          String[]                @default([])
  permissions           String[]                @default([])
  defaultRaffleSettings Json?
  botVerifiedAt         DateTime?
  createdById           String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  backingGuild      Guild                       @relation(fields: [backingGuildId], references: [id], onDelete: Restrict)
  publications      TelegramRafflePublication[]
  deliveries        IntegrationDelivery[]
  members           TelegramCommunityMember[]
  conversations     TelegramConversation[]
  moderationActions KosModerationAction[]

  @@index([organizationId, status])
  @@index([backingGuildId])
  @@map("telegram_communities")
}

/// A Telegram presentation of an existing authoritative KOS raffle.
model TelegramRafflePublication {
  id                String                   @id @default(cuid())
  raffleId          Int
  communityId       String
  telegramMessageId String?
  winnerVisibility  TelegramWinnerVisibility @default(PUBLIC)
  autoAnnouncements Boolean                  @default(true)
  createdById       String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  raffle           Raffle                  @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  community        TelegramCommunity       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  eligibilityRules RaffleEligibilityRule[]
  entryActionToken IntegrationActionToken? @relation("TelegramPublicationEntryToken")
  deliveries       IntegrationDelivery[]

  @@unique([raffleId, communityId])
  @@index([communityId, createdAt])
  @@map("telegram_raffle_publications")
}

/// Provider-specific entry/draw gates attached to a KOS raffle.
model RaffleEligibilityRule {
  id            String                    @id @default(cuid())
  raffleId      Int
  publicationId String?
  provider      RaffleEligibilityProvider
  type          RaffleEligibilityType
  config        Json?
  checkAt       RaffleEligibilityCheckAt  @default(ENTRY)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  raffle      Raffle                     @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  publication TelegramRafflePublication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, type])
  @@index([raffleId, provider, checkAt])
  @@map("raffle_eligibility_rules")
}

/// Durable webhook idempotency marker; raw Telegram updates are not retained.
model TelegramUpdateReceipt {
  id          String               @id @default(cuid())
  botKey      String               @default("main")
  updateId    Int
  status      TelegramUpdateStatus @default(RECEIVED)
  receivedAt  DateTime             @default(now())
  processedAt DateTime?
  error       String?

  @@unique([botKey, updateId])
  @@index([status, receivedAt])
  @@map("telegram_update_receipts")
}

/// Database-backed command/callback limiter so serverless instances share the
/// same abuse boundary.
model TelegramRateLimitBucket {
  id             String   @id @default(cuid())
  telegramUserId String
  scope          String
  windowStart    DateTime
  count          Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([telegramUserId, scope, windowStart], map: "telegram_rate_limit_buckets_telegramUserId_scope_windowStart_ke")
  @@index([windowStart])
  @@map("telegram_rate_limit_buckets")
}

/// Configurable rewards. Bot code resolves point amounts from this table.
model KosRewardDefinition {
  event     KosPointEvent @id
  points    Int
  enabled   Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  @@map("kos_reward_definitions")
}

/// Append-only global KOS points ledger with source-level idempotency.
model KosPointTransaction {
  id          String        @id @default(cuid())
  identityId  String
  event       KosPointEvent
  amount      Int
  reason      String
  source      String
  referenceId String
  createdAt   DateTime      @default(now())

  identity KosIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, event, source, referenceId])
  @@index([identityId, createdAt])
  @@index([event, createdAt])
  @@map("kos_point_transactions")
}

/// Configurable KOS level thresholds.
model KosLevel {
  level     Int      @id
  name      String
  minPoints Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kos_levels")
}

/// One durable referral per referred identity. Completion occurs at onboarding.
model KosReferral {
  id                 String            @id @default(cuid())
  referrerIdentityId String
  referredIdentityId String            @unique
  status             KosReferralStatus @default(PENDING)
  createdAt          DateTime          @default(now())
  completedAt        DateTime?

  referrer KosIdentity @relation("KosReferralReferrer", fields: [referrerIdentityId], references: [id], onDelete: Cascade)
  referred KosIdentity @relation("KosReferralReferred", fields: [referredIdentityId], references: [id], onDelete: Cascade)

  @@index([referrerIdentityId, status])
  @@map("kos_referrals")
}

/// Telegram membership is tracked separately from provider identity.
model TelegramCommunityMember {
  id             String                        @id @default(cuid())
  communityId    String
  telegramUserId String
  identityId     String?
  status         TelegramCommunityMemberStatus @default(ACTIVE)
  approvalStatus KosCommunityApprovalStatus    @default(PENDING)
  requestedAt    DateTime                      @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  joinedAt       DateTime                      @default(now())
  leftAt         DateTime?
  lastSeenAt     DateTime                      @default(now())
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  community TelegramCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  identity  KosIdentity?      @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@unique([communityId, telegramUserId])
  @@index([identityId])
  @@index([communityId, status])
  @@index([communityId, approvalStatus, requestedAt], map: "telegram_community_members_communityId_approvalStatus_requested")
  @@map("telegram_community_members")
}

/// Durable private state for multi-step Telegram workflows.
model TelegramConversation {
  id             String                   @id @default(cuid())
  communityId    String
  telegramChatId String
  telegramUserId String
  kind           TelegramConversationKind
  step           String
  payload        Json
  expiresAt      DateTime
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  community TelegramCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([telegramChatId, telegramUserId, kind])
  @@index([expiresAt])
  @@map("telegram_conversations")
}

model KosNotificationPreference {
  identityId      String   @id
  announcements   Boolean  @default(true)
  raffleReminders Boolean  @default(true)
  winners         Boolean  @default(true)
  points          Boolean  @default(true)
  community       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  identity KosIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("kos_notification_preferences")
}

model KosModerationAction {
  id                   String                  @id @default(cuid())
  communityId          String
  actorTelegramUserId  String
  targetTelegramUserId String
  type                 KosModerationActionType
  reason               String?
  durationSeconds      Int?
  createdAt            DateTime                @default(now())

  community TelegramCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, targetTelegramUserId, createdAt], map: "kos_moderation_actions_communityId_targetTelegramUserId_created")
  @@index([communityId, actorTelegramUserId, createdAt], map: "kos_moderation_actions_communityId_actorTelegramUserId_createdA")
  @@map("kos_moderation_actions")
}

/// Opaque, expiring Telegram deep-link or callback capability.
model IntegrationActionToken {
  id            String                @id @default(cuid())
  tokenHash     String?               @unique
  action        IntegrationActionType
  userId        String?
  publicationId String?               @unique
  payload       Json?
  singleUse     Boolean               @default(true)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime              @default(now())

  publication TelegramRafflePublication? @relation("TelegramPublicationEntryToken", fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([action, expiresAt])
  @@index([userId, action])
  @@map("integration_action_tokens")
}

/// Retryable cross-platform event delivery claimed by the long-running worker.
model IntegrationDelivery {
  id            String                    @id @default(cuid())
  event         IntegrationDeliveryEvent
  status        IntegrationDeliveryStatus @default(PENDING)
  communityId   String
  publicationId String?
  raffleId      Int?
  dedupeKey     String                    @unique
  payload       Json?
  notBefore     DateTime                  @default(now())
  attempts      Int                       @default(0)
  lockedAt      DateTime?
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  community   TelegramCommunity          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  publication TelegramRafflePublication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  raffle      Raffle?                    @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@index([status, notBefore])
  @@index([communityId, createdAt])
  @@index([raffleId, event])
  @@map("integration_deliveries")
}

// ---------------------------------------------------------------------------
// Phase 3 S2 — Task Verification Engine
// ---------------------------------------------------------------------------

/// What a task asks the member to do. X_* verify against the linked X account
/// (link + attest on the free tier); DISCORD_* verify automatically via the
/// bot; VISIT_LINK is click + attest; MANUAL goes to the org's review queue.
enum TaskType {
  X_FOLLOW
  X_LIKE
  X_REPOST
  X_COMMENT
  DISCORD_JOIN
  DISCORD_ROLE
  VISIT_LINK
  MANUAL
}

enum CompletionStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVIEW
}

enum RewardRedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum CampaignEnrollmentStatus {
  JOINED
  COMPLETED
}

enum RaidStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum RaidProofType {
  AUTO
  COMMENT
  QUOTE
  REPOST
  IMAGE
  ANY
}

enum RaidSubmissionStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE
}

enum RaidProofKind {
  X_REPOST
  X_COMMENT_OR_QUOTE
  IMAGE
  MIXED
  UNKNOWN
}

/// A reusable task built by an organization. Referenced by raffles now and
/// campaigns in S3 — build once, attach anywhere.
model TaskDefinition {
  id             String    @id @default(cuid())
  organizationId String
  type           TaskType
  title          String
  description    String?
  /// Per-type settings: { url?, xHandle?, tweetUrl?, guildId?, inviteUrl?,
  /// roleId?, roleName?, instructions? }
  config         Json?
  /// Points awarded on verification (paid out from S3).
  points         Int       @default(0)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  completions   TaskCompletion[]
  raffleTasks   RaffleTask[]
  campaignTasks CampaignTask[]

  @@index([organizationId, active])
  @@map("task_definitions")
}

/// One user's completion state for one task. Evidence records how it was
/// verified (attested handle, discord role snapshot, verifier version…).
model TaskCompletion {
  id           String           @id @default(cuid())
  taskId       String
  userId       String
  status       CompletionStatus @default(PENDING)
  evidence     Json?
  verifiedAt   DateTime?
  reviewedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  task TaskDefinition @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId, status])
  @@map("task_completions")
}

/// Append-only organization points ledger. Balance is SUM(delta) per
/// (organizationId, userId). Awarding task points uses sourceType/sourceId to
/// stay idempotent.
model PointsLedger {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  delta          Int
  reason         String
  sourceType     String
  sourceId       String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, sourceType, sourceId])
  @@index([organizationId, userId])
  @@index([organizationId, createdAt])
  @@map("points_ledger")
}

/// A points-store item that members can redeem with earned organization
/// points. Stock null means unlimited inventory.
model Reward {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?
  cost           Int
  stock          Int?
  active         Boolean  @default(true)
  metadata       Json?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemptions  RewardRedemption[]

  @@index([organizationId, active])
  @@map("rewards")
}

/// A user's request to spend points on a reward. The points spend is recorded
/// as a negative PointsLedger row with sourceType REWARD_REDEEM and sourceId
/// equal to this id.
model RewardRedemption {
  id             String                 @id @default(cuid())
  organizationId String
  rewardId       String
  userId         String
  cost           Int
  status         RewardRedemptionStatus @default(PENDING)
  note           String?
  fulfilledById  String?
  fulfilledAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reward       Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([rewardId, status])
  @@index([userId, createdAt])
  @@map("reward_redemptions")
}

/// A time-bounded organization quest that groups reusable tasks and raffles.
/// Members explicitly join, then complete required linked steps for a one-time
/// points bonus backed by the shared append-only PointsLedger.
model Campaign {
  id               String         @id @default(cuid())
  organizationId   String
  title            String
  description      String?
  status           CampaignStatus @default(DRAFT)
  startAt          DateTime?
  endAt            DateTime?
  completionPoints Int            @default(0)
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        CampaignTask[]
  raffles      CampaignRaffle[]
  enrollments  CampaignEnrollment[]

  @@index([organizationId, status])
  @@index([status, startAt])
  @@index([status, endAt])
  @@map("campaigns")
}

/// Reusable Task Engine step attached to a campaign.
model CampaignTask {
  id         String  @id @default(cuid())
  campaignId String
  taskId     String
  required   Boolean @default(true)
  position   Int     @default(0)

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  task     TaskDefinition @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([campaignId, taskId])
  @@index([campaignId, position])
  @@index([taskId])
  @@map("campaign_tasks")
}

/// Existing raffle participation step attached to a campaign. The raffle
/// remains the source of truth for entry and results.
model CampaignRaffle {
  id         String  @id @default(cuid())
  campaignId String
  raffleId   Int
  required   Boolean @default(true)
  position   Int     @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  raffle   Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([campaignId, raffleId])
  @@index([campaignId, position])
  @@index([raffleId])
  @@map("campaign_raffles")
}

/// One member's participation and completion state for one campaign.
model CampaignEnrollment {
  id          String                   @id @default(cuid())
  campaignId  String
  userId      String
  status      CampaignEnrollmentStatus @default(JOINED)
  joinedAt    DateTime                 @default(now())
  completedAt DateTime?
  updatedAt   DateTime                 @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId, updatedAt])
  @@index([campaignId, status])
  @@map("campaign_enrollments")
}

/// A scheduled Discord engagement raid owned by an organization. The
/// dashboard persists intent and the long-running bot owns every Discord-side
/// effect: role creation, post/thread lifecycle, proof intake, and rewards.
model Raid {
  id                        String        @id @default(cuid())
  organizationId            String
  guildId                   String
  title                     String
  tweetUrls                 String[]      @default([])
  instructions              String
  proofType                 RaidProofType @default(AUTO)
  status                    RaidStatus    @default(DRAFT)
  startPing                 String        @default("everyone")
  startAt                   DateTime
  endAt                     DateTime
  channelId                 String
  staffChannelId            String?
  messageId                 String?
  threadId                  String?
  rewardRoleId              String?
  rewardRoleName            String
  rewardRoleCreated         Boolean       @default(false)
  participantLimit          Int?
  allowMultipleSubmissions  Boolean       @default(false)
  announcementMessage       String?
  validParticipantCount     Int           @default(0)
  failureReason             String?
  summaryChannelId          String?
  summaryMessageId          String?
  roleAssignmentCount       Int           @default(0)
  roleAssignmentFailedCount Int           @default(0)
  startedAt                 DateTime?
  endedAt                   DateTime?
  cancelledAt               DateTime?
  finalizedAt               DateTime?
  editRequestedAt           DateTime?
  createdById               String
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  guild        Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  participants RaidParticipant[]
  submissions  RaidSubmission[]

  @@index([organizationId, status])
  @@index([guildId, status])
  @@index([status, startAt])
  @@index([status, endAt])
  @@index([threadId])
  @@map("raids")
}

/// One member's current aggregate state in a raid. Individual attempts remain
/// in RaidSubmission so duplicates and retries stay auditable.
model RaidParticipant {
  id                  String               @id @default(cuid())
  raidId              String
  userId              String
  status              RaidSubmissionStatus @default(PENDING)
  roleAssignedAt      DateTime?
  roleAssignmentError String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  raid        Raid             @relation(fields: [raidId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions RaidSubmission[]

  @@unique([raidId, userId])
  @@index([raidId, status])
  @@index([userId, updatedAt])
  @@map("raid_participants")
}

/// A proof message submitted in the raid thread/channel. Message ids and
/// fingerprints make gateway retries and repeated evidence idempotent.
model RaidSubmission {
  id            String               @id @default(cuid())
  raidId        String
  participantId String
  userId        String
  messageId     String               @unique
  channelId     String
  content       String?
  status        RaidSubmissionStatus @default(PENDING)
  proofKind     RaidProofKind        @default(UNKNOWN)
  fingerprint   String
  evidence      Json?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  raid        Raid                       @relation(fields: [raidId], references: [id], onDelete: Cascade)
  participant RaidParticipant            @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments RaidSubmissionAttachment[]

  @@index([raidId, status])
  @@index([raidId, userId])
  @@index([participantId, createdAt])
  @@index([raidId, fingerprint])
  @@map("raid_submissions")
}

/// Durable screenshot proof. Discord attachment URLs expire, so supported
/// images are copied into shared PostgreSQL storage at submission time.
model RaidSubmissionAttachment {
  id           String   @id @default(cuid())
  submissionId String
  fileName     String
  contentType  String
  byteLength   Int
  data         Bytes
  createdAt    DateTime @default(now())

  submission RaidSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("raid_submission_attachments")
}

/// Attach a task to a raffle. Required tasks gate entry.
model RaffleTask {
  id       String  @id @default(cuid())
  raffleId Int
  taskId   String
  required Boolean @default(true)

  raffle Raffle         @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  task   TaskDefinition @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([raffleId, taskId])
  @@index([raffleId])
  @@map("raffle_tasks")
}

/// A personal notification (win, raffle result, system). Announcements are
/// merged into the feed at read time — they are NOT fanned out into rows.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// WIN | RESULT | SYSTEM
  type      String
  title     String
  body      String?
  /// Relative dashboard link (e.g. /me/history or /c/kos/raffles/12).
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Announcement banner (Super Admin). Null organizationId = all orgs.
model Announcement {
  id             String            @id @default(cuid())
  title          String
  body           String
  level          AnnouncementLevel @default(INFO)
  active         Boolean           @default(true)
  /// Target a single org, or null to broadcast to every org.
  organizationId String?
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@map("announcements")
}

/// Monthly ceiling on billable X API reads (X_VERIFY_MONTHLY_READ_BUDGET).
/// One row per UTC calendar month; reads are claimed before a request goes out
/// so concurrent verifies can't race past the budget together.
model XVerifyBudget {
  /// UTC month key, "YYYY-MM".
  month     String   @id
  /// Billable X user-object reads charged this month.
  reads     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("x_verify_budget")
}

enum XEngagementKind {
  LIKE
  REPOST
}

/// Cached engager set for one X post, so a like/repost task is swept once and
/// then answered from the database for every member. `complete` is the safety
/// bit: when the page cap cut the sweep short, absence from the set does NOT
/// mean the member skipped it, so callers must fall back to attest.
model XEngagementSweep {
  id         String          @id @default(cuid())
  /// X post id (the numeric status id).
  tweetId    String
  kind       XEngagementKind
  /// When the engager set was last refreshed from X.
  fetchedAt  DateTime
  /// True only when the entire engager list was read.
  complete   Boolean         @default(false)
  /// Engagers recorded by the last sweep.
  actorCount Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  actors XEngagementActor[]

  @@unique([tweetId, kind])
  @@map("x_engagement_sweeps")
}

/// One X account seen engaging with a swept post.
model XEngagementActor {
  sweepId String
  /// X numeric user id, matched against ConnectedAccount.externalId.
  xUserId String

  sweep XEngagementSweep @relation(fields: [sweepId], references: [id], onDelete: Cascade)

  @@id([sweepId, xUserId])
  @@map("x_engagement_actors")
}

/// One row per outbound X API call (and per cache hit that avoided one).
/// This is the ground truth for what verification actually costs: the budget
/// ledger only counts, this explains. Cache hits are logged with cost 0 so the
/// saving is measurable rather than asserted.
model XApiUsageLog {
  id             String   @id @default(cuid())
  /// Endpoint template, ids stripped — e.g. "/2/users/by/username/:handle".
  endpoint       String
  method         String   @default("GET")
  /// Why we called: follow_check, post_metrics, engager_sweep_page.
  operation      String
  /// Billable resources this call returned (0 for a cache hit).
  resources      Int      @default(0)
  /// USD at the rate in x-pricing.ts when the call was made. ESTIMATED.
  estimatedCost  Decimal  @default(0) @db.Decimal(12, 6)
  /// True when we answered from cache and made no request at all.
  cached         Boolean  @default(false)
  statusCode     Int?
  durationMs     Int?
  /// Verifier outcome, for correlating spend with results.
  outcome        String?
  /// Attribution. Nullable because not every call has all of them.
  organizationId String?
  raffleId       Int?
  taskId         String?
  userId         String?
  xUserId        String?
  /// Retry attempt number, 0 for the first try.
  attempt        Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([operation, createdAt])
  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@index([raffleId])
  @@map("x_api_usage_logs")
}
