################################################################################
# KOS WL Bot — environment configuration
# Copy to .env and fill in. NEVER commit your real .env.
################################################################################

# ---------------------------------------------------------------------------
# Database (shared by bot + dashboard)
# ---------------------------------------------------------------------------
# Local: postgresql://kos:kos@localhost:5432/kos
# Docker compose default: postgresql://kos:kos@postgres:5432/kos
DATABASE_URL="postgresql://kos:kos@localhost:5432/kos"

# ---------------------------------------------------------------------------
# Discord bot
# ---------------------------------------------------------------------------
# From https://discord.com/developers/applications -> your app -> Bot -> Token
DISCORD_TOKEN="your-bot-token"
# Application (client) ID from the General Information page
DISCORD_CLIENT_ID="your-application-id"
# Optional: a guild id for INSTANT slash-command registration during dev.
# Leave empty in production to register commands globally.
DISCORD_GUILD_ID=""

# ---------------------------------------------------------------------------
# Telegram integration (optional; feature-disabled until configured)
# ---------------------------------------------------------------------------
# BotFather token shared by the Vercel webhook and EC2 delivery worker.
TELEGRAM_BOT_TOKEN=""
# Bot username without @, used for secure account-link deep links.
TELEGRAM_BOT_USERNAME=""
# Generate: openssl rand -hex 32. Set the same value in Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=""
# Portable aliases accepted by the KOS Telegram runtime.
BOT_TOKEN=""
APP_URL="http://localhost:3001"
WEBHOOK_URL=""
WEBHOOK_SECRET=""
# Local polling is intentionally opt-in because Telegram disables webhooks
# while getUpdates is active. Set WEBHOOK_URL/SECRET to restore it on shutdown.
TELEGRAM_LOCAL_POLLING="false"
# Reserved for later distributed jobs and out-of-process KOS integrations.
REDIS_URL=""
KOS_API_URL=""
KOS_API_KEY=""

# ---------------------------------------------------------------------------
# Bot behaviour
# ---------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"                      # fatal|error|warn|info|debug|trace
PROOF_OUTPUT_DIR="./generated/proofs" # where PDF/CSV/PNG proofs are written
EMBED_REFRESH_SECONDS="30"            # live embed countdown refresh cadence
SCHEDULER_TICK_SECONDS="15"           # floor between ticks when work is due
SCHEDULER_IDLE_SECONDS="900"          # max sleep when idle; the main Neon cost lever
DASHBOARD_PRESENCE_SECONDS="120"      # sweep fast for this long after a dashboard request
SCHEDULER_BATCH_SIZE="25"             # max records per scheduler operation/tick
ENTRY_RATE_LIMIT_PER_MINUTE="8"       # per-user Enter/Leave anti-spam

# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
# Enables AES-256-GCM encryption of winner wallet addresses at rest.
WALLET_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------
KOS_BRAND_NAME="KOS Raffles"
KOS_LOGO_URL=""                       # https URL to a PNG logo (optional)

# ---------------------------------------------------------------------------
# Internal control API (lets the dashboard trigger reroll/end with live
# Discord announcements). Bound to 127.0.0.1 by the bot.
# ---------------------------------------------------------------------------
INTERNAL_API_PORT="4000"
# Generate: openssl rand -hex 24   (min 24 chars). Shared with the dashboard.
INTERNAL_API_TOKEN=""

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
DASHBOARD_URL="http://localhost:3001" # used in proof embeds (optional)
PUBLIC_RAFFLE_ORIGIN="https://raffle.koslabs.app" # stable share/banner origin
# Where the dashboard reaches the bot's internal API:
BOT_INTERNAL_URL="http://127.0.0.1:4000"
# Simple shared-secret auth. Leave DASHBOARD_SESSION_TOKEN empty to DISABLE
# auth (only safe behind a VPN/private network). For real access control,
# set both and/or switch to Discord OAuth (see docs/SECURITY.md).
DASHBOARD_PASSWORD="change-me"
DASHBOARD_SESSION_TOKEN=""            # openssl rand -hex 32  (also signs OAuth sessions)
# Bearer token for the read-only Google Sheets Discord member feed.
# Generate: openssl rand -hex 32. Store the same value in Apps Script Properties.
SHEETS_SYNC_TOKEN=""

# --- Discord OAuth login (recommended) ---
# Developer Portal -> OAuth2 -> reset/copy the Client Secret, and add this
# redirect URL under OAuth2 -> Redirects:
#   <DASHBOARD_URL>/api/auth/discord/callback
# (locally: http://localhost:3001/api/auth/discord/callback)
DISCORD_CLIENT_SECRET=""
# Comma-separated Discord user IDs always allowed in. If this AND manager roles
# are both empty, any member of DISCORD_GUILD_ID can sign in (lock down later).
DASHBOARD_ALLOWED_USER_IDS=""

# ---------------------------------------------------------------------------
# X (Twitter) — account linking + real follow verification
# ---------------------------------------------------------------------------
# developer.x.com -> your app -> User authentication settings:
#   Type of App: Web App  |  App permissions: Read
#   Callback URI: <DASHBOARD_URL>/api/connect/x/callback
#   (locally: http://localhost:3001/api/connect/x/callback)
# Scopes requested: users.read tweet.read follows.read offline.access
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# --- Real follow verification (costs money — read before enabling) ---
# X retired its free tier in Feb 2026 and now bills per RESOURCE RETURNED.
# A follow check reads one user object — the TARGET account — at $0.010, and
# resources are deduplicated per 24h UTC window. So a follow task costs roughly
# $0.010 per target per day no matter how many members verify it, not $0.010
# per member. Likes/reposts are still NOT checked: those page the post's whole
# engager list, so they scale with the post rather than the task.
#
# off         nothing is spent; every X task is link + attest (default)
# follow_only X_FOLLOW is checked against the X API; the rest attest
# full        follows + likes + reposts are checked; comments still attest
X_VERIFY_MODE="off"
#
# Hard ceiling on billable X reads per UTC calendar month, counted in the
# x_verify_budget table. This counts REQUESTS, so it is an upper bound —
# deduplicated repeats still count here but X does not bill them, meaning real
# spend lands well under budget x $0.010. Once spent, follow checks fall back
# to attest instead of blocking members. Both guards must be set for real
# verification to run at all.
#
# Also set a Spending limit in the X Developer Console as the outer backstop —
# that one is enforced by X, and matters most if you turn on auto-recharge.
X_VERIFY_MONTHLY_READ_BUDGET="0"

# --- Like / repost sweeps (X_VERIFY_MODE=full only) ---
# Likes and reposts can't be checked per member — X has no "did this user like
# it" field. Instead the post's engager list is swept ONCE with an app-only
# bearer token, cached, and every member is answered from the cache. Cost lands
# on the post rather than the crowd. Developer Portal -> Keys and tokens ->
# Bearer Token. Without this, likes/reposts stay on attest even in full mode.
X_BEARER_TOKEN=""
# Pages per sweep, 100 engagers each. This is the hard ceiling on what a single
# post can ever cost: 20 pages = 2,000 engagers. When a post is bigger than the
# cap the sweep is marked incomplete and members fall back to attest rather
# than being wrongly rejected for sitting past the cap.
X_SWEEP_MAX_PAGES="20"
# How long a cached engager set is trusted before it is swept again. Both
# engagement endpoints allow only 75 requests/15min app-wide, so a short TTL on
# a busy raffle will rate-limit rather than go faster.
X_SWEEP_TTL_MINUTES="10"

# ---------------------------------------------------------------------------
# Optional seed (packages/db: pnpm db:seed)
# ---------------------------------------------------------------------------
SEED_GUILD_ID=""
SEED_GUILD_NAME=""
SEED_MANAGER_ROLE_IDS=""              # comma-separated role ids
SEED_ANNOUNCE_CHANNEL_ID=""
SEED_PROOF_CHANNEL_ID=""
